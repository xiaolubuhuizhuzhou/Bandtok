{
  "model_type": "bandtok",
  "sample_rate": 44100,
  "sample_size": 65024,
  "audio_channels": 1,
  "n_fft": 2048,
  "num_mels": 128,
  "hop_size": 512,
  "win_size": 2048,
  "model": {
    "encoder": {
      "type": "cosmos",
      "config": {
        "patch_size": 2,
        "patch_method": "haar",
        "in_channels": 1,
        "channels": 128,
        "channels_mult": [
          2,
          4
        ],
        "num_res_blocks": 2,
        "attn_resolutions": [
          32,
          16
        ],
        "dropout": 0.0,
        "resolution": 128,
        "z_channels": 128,
        "spatial_compression": 8
      }
    },
    "mel_decoder": {
      "type": "cosmos",
      "config": {
        "patch_size": 2,
        "patch_method": "haar",
        "out_channels": 1,
        "channels": 128,
        "channels_mult": [
          2,
          4
        ],
        "num_res_blocks": 2,
        "attn_resolutions": [
          32,
          16
        ],
        "dropout": 0.0,
        "resolution": 128,
        "z_channels": 128,
        "spatial_compression": 8
      }
    },
    "bottleneck": {
      "type": "band_vq",
      "config": {
        "input_dim": 128,
        "n_codebooks": 1,
        "codebook_size": 8192,
        "quantizer_dropout": 0.0,
        "quantize_ema_decay": 0.0
      }
    },
    "latent_dim": 128
  },
  "training": {
    "precision": "32-true",
    "warmup_steps": 0,
    "clip_grad_norm": 0.0,
    "optimizer_configs": {
      "autoencoder": {
        "optimizer": {
          "type": "AdamW",
          "config": {
            "lr": 0.0002,
            "betas": [
              0.8,
              0.99
            ]
          }
        },
        "scheduler": {
          "type": "InverseLR",
          "config": {
            "inv_gamma": 200000,
            "power": 0.5,
            "warmup": 0.999
          }
        }
      },
      "discriminator": {
        "optimizer": {
          "type": "AdamW",
          "config": {
            "lr": 0.0002,
            "betas": [
              0.8,
              0.99
            ]
          }
        },
        "scheduler": {
          "type": "InverseLR",
          "config": {
            "inv_gamma": 200000,
            "power": 0.5,
            "warmup": 0.999
          }
        }
      }
    },
    "loss_configs": {
      "L_mel": {
        "weights": {
          "L_mel": 5.0
        }
      },
      "L_vgg_l1": {
        "weights": {
          "L_vgg_l1": 1.0
        }
      },
      "discriminator_mel": {
        "type": "patchgan",
        "config": {
          "use_hinge": false,
          "scales": [
            1,
            2
          ],
          "ndf": 64,
          "max_downs": [
            16,
            16
          ],
          "use_ckpt": false,
          "preprocess": "logmel"
        },
        "weights": {
          "discriminator": 1.0,
          "adversarial": 1.0,
          "feature_matching": 5.0
        }
      },
      "bottleneck": {
        "type": "band_vq",
        "weights": {
          "commit": 2.5
        }
      }
    },
    "logging": {
      "log_every": 20
    },
    "checkpoint": {
      "every_n_train_steps": 5000,
      "keep_every_n_steps": 100000,
      "keep_last_k": 0
    },
    "val_every": 10000,
    "val_steps": 50,
    "demo": {
      "demo_every": 5000
    }
  }
}
